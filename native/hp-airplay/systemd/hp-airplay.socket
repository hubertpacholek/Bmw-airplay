# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=hp-airplay control socket (the app AirPlay HP)

[Socket]
# The app's connection starts hp-airplay.service; nothing of the test runs before it, at boot
# included. Root's alone when made; sockgroup.js then gives it the AirPlay HP app's own group (0660),
# not tm_oap_app, which every app has. The socket file goes when the socket stops (an uninstall).
ListenStream=/run/hp-airplay.sock
SocketMode=0600
RemoveOnStop=yes
ExecStartPost=-/bin/sh -c 'ulimit -c 1; exec /usr/bin/node /var/opt/hp-airplay/current/sockgroup.js'
# no core dump from the command above to the crash handler
LimitCORE=1

[Install]
WantedBy=sockets.target
