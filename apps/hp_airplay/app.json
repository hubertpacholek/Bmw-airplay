{
  "id": "hp_airplay",
  "title": "AirPlay HP",
  "description": "The head unit as an AirPlay receiver for an iPhone: screen mirroring on the centre screen with the sound on the car's speakers (also with wireless CarPlay connected), and videos sent with the AirPlay button (YouTube) played by the head unit itself, with their controls on the iDrive. The picture shows while parked. Needs the AirPlay HP service.",
  "version": "1.5.0",
  "language": "pl",
  "vendor": "custom",
  "loggingId": "OA9A",
  "iconGlyph": "AP",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections"
      ]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ]
    }
  },
  "requires": {
    "hp-airplay": "1.5.0"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AirPlay HP",
      "buttons": [
        [
          "BTN_RX",
          "Włącz AirPlay"
        ],
        [
          "BTN_STOP",
          "Zatrzymaj"
        ],
        [
          "BTN_SETTINGS",
          "Ustawienia"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "hudMode",
      "label": "Obraz na HUD (wymaga cluster-render ze Store)",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Wyłączony"
        ],
        [
          "parked",
          "Tylko na postoju"
        ],
        [
          "always",
          "Także w czasie jazdy (HUD widzi tylko pasażer)"
        ]
      ]
    },
    {
      "key": "parkedOnly",
      "label": "Obraz na ekranie tylko na postoju (wyłączone: także w czasie jazdy, dla pasażera; kierowca nie może patrzeć)",
      "type": "bool",
      "default": true
    },
    {
      "key": "filmFill",
      "label": "Film na cały ekran: bez czarnych pasów filmu (odbicie lustrzane i film z YouTube), w kształcie z ustawienia niżej",
      "type": "bool",
      "default": true
    },
    {
      "key": "aspect",
      "label": "Kształt filmu na ekranie (także przycisk na pasku filmu z YouTube)",
      "type": "choice",
      "default": "fill",
      "options": [
        [
          "fill",
          "Wypełnij: cały ekran, brzegi przycięte"
        ],
        [
          "zoom",
          "Powiększ: pośrodku"
        ],
        [
          "fit",
          "Cały: cały film, czarne pasy"
        ]
      ]
    },
    {
      "key": "videoButton",
      "label": "Przycisk AirPlay w filmie (YouTube): jednostka sama odtwarza film (tylko gdy iPhone nie jest w CarPlay)",
      "type": "bool",
      "default": true
    },
    {
      "key": "endOnLeave",
      "label": "Kończ odbicie lustrzane po wyjściu z aplikacji (CarPlay od razu wolne)",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Kolory",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M czerwony"
        ],
        [
          "m_tricolour",
          "M trójkolorowy"
        ],
        [
          "ice",
          "Lodowa biel"
        ],
        [
          "amber",
          "Nocny bursztyn"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Układ ekranu",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Pełny ekran"
        ],
        [
          "standard",
          "Standardowy"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Rysowanie",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 kl./s (domyślnie)"
        ],
        [
          "software",
          "Programowe"
        ]
      ]
    }
  ]
}
